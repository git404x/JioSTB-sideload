#!/usr/bin/env bash
# ==============================================================================
# jiostb — Master Orchestrator CLI for Jio STB Exploitation & FOSS Sideloading
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Load configuration if present
if [ -f "$SCRIPT_DIR/config/network.env" ]; then
    # shellcheck source=/dev/null
    source "$SCRIPT_DIR/config/network.env"
elif [ -f "$SCRIPT_DIR/config/network.env.example" ]; then
    # shellcheck source=/dev/null
    source "$SCRIPT_DIR/config/network.env.example"
fi

TARGET="${STB_IP:-192.168.29.170}:${STB_PORT:-5555}"
MODEL="${STB_MODEL:-jhs}"

# Colors
C_RESET='\033[0m'
C_BOLD='\033[1m'
C_GREEN='\033[32m'
C_CYAN='\033[36m'
C_YELLOW='\033[33m'
C_RED='\033[31m'

banner() {
    cat <<'EOF'
       __ _       ____ _____ ____            _     _      _                 _ 
      / /(_)___  / ___|_   _| __ )       ___(_) __| | ___| | ___   __ _  __| |
     / / | / _ \ \___ \ | | |  _ \ _____/ __| |/ _` |/ _ \ |/ _ \ / _` |/ _` |
  _ / /  | | (_) |___) || | | |_) |_____|__ \ | (_| |  __/ | (_) | (_| | (_| |
 (_)_/   |_|\___/|____/ |_| |____/      |___/_|\__,_|\___|_|\___/ \__,_|\__,_|
================================================================================
Universal Exploitation, TR-069 ACS Penetration, and FOSS Provisioning Toolkit
================================================================================
EOF
}

usage() {
    banner
    echo -e "${C_BOLD}USAGE:${C_RESET}"
    echo -e "  ./jiostb <command> [arguments]\n"
    echo -e "${C_BOLD}COMMANDS:${C_RESET}"
    echo -e "  ${C_CYAN}check${C_RESET}                   Verify ADB connection, detect hardware model & memory"
    echo -e "  ${C_CYAN}net ethernet${C_RESET}            Start isolated direct Ethernet link with DNS hijack"
    echo -e "  ${C_CYAN}net ap${C_RESET}                  Start Wi-Fi hotspot mode with DNS hijack"
    echo -e "  ${C_CYAN}net down${C_RESET}                Teardown active network redirection"
    echo -e "  ${C_CYAN}acs start [jhs|jmsc]${C_RESET}    Launch GenieACS backend & pass_front.py TLS proxy"
    echo -e "  ${C_CYAN}acs stop${C_RESET}                Stop GenieACS containers and TLS proxy"
    echo -e "  ${C_CYAN}fetch${C_RESET}                   Download latest verified FOSS APKs (GitLab/GitHub)"
    echo -e "  ${C_CYAN}install [launcher]${C_RESET}      Sideload FOSS stack & set launcher (projectivy|flauncher)"
    echo -e "  ${C_CYAN}debloat${C_RESET}                 Execute user-confirmed surgical debloat (54 packages)"
    echo -e "  ${C_CYAN}restore${C_RESET}                 1-click emergency restoration of all stock JioOS apps"
    echo -e "  ${C_CYAN}dump${C_RESET}                    Extract full stock boot.img & recovery.img partitions"
    echo -e "  ${C_CYAN}scrcpy${C_RESET}                  Launch Vulkan & HW-accelerated display on laptop"
    echo -e "  ${C_CYAN}shell${C_RESET}                   Open interactive ADB shell to STB"
    echo -e "  ${C_CYAN}reboot${C_RESET}                  Reboot the STB over ADB\n"
}

cmd_check() {
    echo -e "${C_CYAN}[+] Checking ADB target: $TARGET ...${C_RESET}"
    if ! adb devices | grep -q "$TARGET"; then
        echo -e "[*] Connecting to $TARGET..."
        adb connect "$TARGET" || true
    fi

    if ! adb -s "$TARGET" get-state >/dev/null 2>&1; then
        echo -e "${C_RED}[!] Device $TARGET is offline or not connected.${C_RESET}"
        adb devices -l
        exit 1
    fi

    echo -e "${C_GREEN}[✓] Device Connected!${C_RESET}"
    echo -n "  Model:       " && adb -s "$TARGET" shell "getprop ro.product.model"
    echo -n "  Platform:    " && adb -s "$TARGET" shell "getprop ro.board.platform"
    echo -n "  Firmware:    " && adb -s "$TARGET" shell "getprop ro.build.display.id"
    echo -n "  Android API: " && adb -s "$TARGET" shell "getprop ro.build.version.release"
    echo -n "  CPU ABI:     " && adb -s "$TARGET" shell "getprop ro.product.cpu.abi"
    echo -n "  ADB State:   " && adb -s "$TARGET" shell "getprop persist.iwedia.tr.adb.state 2>/dev/null || echo unknown"
    echo -e "\n${C_BOLD}Active Memory & Storage:${C_RESET}"
    adb -s "$TARGET" shell "free -m" | head -n 3
    adb -s "$TARGET" shell "df -h /data"
}

case "${1:-}" in
    check)
        cmd_check
        ;;
    net)
        ACTION="${2:-help}"
        if [ "$ACTION" = "ethernet" ]; then
            exec "$SCRIPT_DIR/services/network/setup_ethernet.sh"
        elif [ "$ACTION" = "ap" ]; then
            exec "$SCRIPT_DIR/services/network/setup_wifi_ap.sh"
        elif [ "$ACTION" = "down" ] || [ "$ACTION" = "stop" ]; then
            "$SCRIPT_DIR/services/network/setup_ethernet.sh" --teardown || true
            "$SCRIPT_DIR/services/network/setup_wifi_ap.sh" --teardown || true
        else
            echo "Usage: ./jiostb net [ethernet|ap|down]"
        fi
        ;;
    acs)
        ACTION="${2:-start}"
        if [ "$ACTION" = "start" ]; then
            M="${3:-$MODEL}"
            exec "$SCRIPT_DIR/services/setup_acs.sh" "$M"
        elif [ "$ACTION" = "stop" ]; then
            echo "[+] Stopping pass_front.py..."
            pkill -f "pass_front.py" 2>/dev/null || true
            echo "[+] Stopping GenieACS containers..."
            podman-compose -f "$SCRIPT_DIR/services/docker-compose.yml" down 2>/dev/null || \
            docker-compose -f "$SCRIPT_DIR/services/docker-compose.yml" down 2>/dev/null || true
            echo "  [✓] ACS stopped."
        else
            echo "Usage: ./jiostb acs [start|stop]"
        fi
        ;;
    fetch)
        exec "$SCRIPT_DIR/scripts/fetch_foss_apks.sh"
        ;;
    install)
        LAUNCHER="${2:-projectivy}"
        exec "$SCRIPT_DIR/scripts/install_foss_apps.sh" "$TARGET" "$LAUNCHER"
        ;;
    debloat)
        exec "$SCRIPT_DIR/scripts/debloat.sh" "$TARGET"
        ;;
    restore)
        exec "$SCRIPT_DIR/scripts/undo.sh" "$TARGET"
        ;;
    dump)
        exec "$SCRIPT_DIR/scripts/dump_partitions.sh" "$TARGET" "$MODEL"
        ;;
    scrcpy)
        shift
        exec "$SCRIPT_DIR/scripts/launch_scrcpy.sh" "$TARGET" "$@"
        ;;
    shell)
        exec adb -s "$TARGET" shell
        ;;
    reboot)
        echo "[+] Rebooting $TARGET..."
        exec adb -s "$TARGET" reboot
        ;;
    -h|--help|help|"")
        usage
        ;;
    *)
        echo -e "${C_RED}[!] Unknown command: $1${C_RESET}"
        usage
        exit 1
        ;;
esac
