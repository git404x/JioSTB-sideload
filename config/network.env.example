# ==============================================================================
# JioSTB-sideload — Network & Target Configuration
# Copy this file to config/network.env and customize if needed.
# ==============================================================================

# STB Target Configuration
STB_IP="192.168.29.170"
STB_PORT="5555"
STB_MODEL="jhs"                # 'jhs' (JHSB200/JHSC200) or 'jmsc' (JMSC200A/JMSD200A)

# Direct Ethernet Link Mode Settings
ETHERNET_IFACE="enp2s0"
ETHERNET_HOST_IP="192.168.42.1"
ETHERNET_SUBNET_MASK="255.255.255.0"
ETHERNET_DHCP_START="192.168.42.50"
ETHERNET_DHCP_END="192.168.42.100"

# Wi-Fi Access Point Mode Settings
WIFI_IFACE="wlan0"
AP_SSID="JioSTB-Unlock"
AP_PASSPHRASE="jiostbdebloat"
AP_HOST_IP="192.168.50.1"
AP_DHCP_START="192.168.50.50"
AP_DHCP_END="192.168.50.100"

# TR-069 ACS Settings
ACS_HOST_DOMAIN="acs.oss.jio.com"
ACS_TLS_PORT_JHS="9443"
ACS_TLS_PORT_JMSC="8443"
GENIEACS_NBI_PORT="7557"
GENIEACS_UI_PORT="3008"        # Remapped to avoid collision with AdGuard Home (:3000)
